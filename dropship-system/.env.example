# ===========================================
# DROPSHIP SYSTEM — VARIABLES D'ENVIRONNEMENT
# ===========================================
# Copier ce fichier en `.env` à la racine du projet puis remplir les valeurs.
# NE JAMAIS committer le fichier `.env`.
# Le script `pnpm run validate-env` teste chaque connexion.

# --- Anthropic (Claude API) — REQUIS ---
# Récupérer sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle par défaut utilisé pour la plupart des tâches (copy, research, analytics)
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
# Modèle "créatif" pour branding, hooks, storytelling (plus qualitatif, plus cher)
ANTHROPIC_MODEL_CREATIVE=claude-opus-4-6

# --- Supabase — REQUIS ---
# Créer un projet sur https://supabase.com/dashboard puis copier ces 3 valeurs
# depuis Settings > API.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé service_role : gardée côté serveur UNIQUEMENT, jamais dans le dashboard client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Bucket storage utilisé pour uploader les vidéos rendues
SUPABASE_STORAGE_BUCKET=creatives

# --- Shopify Admin API — REQUIS ---
# Créer une "custom app" dans votre boutique Shopify :
# Settings > Apps and sales channels > Develop apps > Create an app
# Scopes requis : write_products, write_themes, write_content, write_online_store_pages,
# write_files, write_translations, read_analytics
SHOPIFY_DEFAULT_DOMAIN=votre-boutique.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# --- Meta (Facebook/Instagram) Marketing API ---
# https://developers.facebook.com/apps/ → Créer app Business
# Puis Meta Business Suite > Paramètres > Comptes publicitaires
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_PAGE_ID=
META_PIXEL_ID=

# --- TikTok Marketing API ---
# https://ads.tiktok.com/marketing_api/homepage
# ⚠️ Approbation d'app peut prendre plusieurs semaines.
# Si non configuré, les agents basculent en mode mock (upload manuel).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_PIXEL_ID=

# --- ElevenLabs (voix off — optionnel) ---
# https://elevenlabs.io/app/settings/api-keys
# Désactivé par défaut ; activer avec --voice-over dans les scripts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FR=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_ENABLED=false

# --- Pexels (b-rolls vidéo — REQUIS pour créas) ---
# https://www.pexels.com/api/new/
PEXELS_API_KEY=

# --- Google Analytics 4 (optionnel, pour tracking sur boutiques) ---
GA4_MEASUREMENT_ID=

# --- Config système ---
# Niveau de log : debug | info | warn | error
LOG_LEVEL=info
# Mode dry-run global : quand true, aucune dépense pub n'est engagée (simulation)
DRY_RUN=true
# Seuil de kill-switch automatique (CPA multiplicateur déclenchant pause)
KILL_SWITCH_CPA_MULTIPLIER=2
# Langues supportées (séparées par virgule)
SUPPORTED_LOCALES=fr,en
# Locale par défaut
DEFAULT_LOCALE=fr

# --- Dashboard Next.js (variables publiques, préfixées NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_APP_NAME=Dropship System
