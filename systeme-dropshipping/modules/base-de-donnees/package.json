{
  "name": "@dropship/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schéma Supabase + migrations + helpers (typés) pour la base de données du système.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
