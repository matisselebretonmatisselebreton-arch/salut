    "./migrations/0001": "./migrations/0001_initial_schema.sql"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.6.3"
  }
}
